# Server-side Production variables only. These are not browser/VITE_ variables.
# Never configure these for Preview or Development. No secrets in vercel.json.
NOVA_PUBLIC_ORIGIN=https://your-selected-project.vercel.app
NOVA_ORIGIN=https://your-verified-vps-hostname.example
# 64 lowercase hex characters encoding an independent random 32-byte key.
NOVA_PROXY_KEY=
# Keep unset until All Deployments authentication has passed anonymous checks.
NOVA_GATEWAY_ENABLED=
