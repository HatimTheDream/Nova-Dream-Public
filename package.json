{
  "name": "nova-dream-edition-3",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Nova Dream daily workspace",
  "engines": {
    "node": ">=22.19.0"
  },
  "edition3": {
    "buildVersion": "1.0.171",
    "schemaVersion": 54,
    "apiVersion": 1,
    "appId": "private.novadream.edition3.preview"
  },
  "scripts": {
    "dev": "npm run build:service && node scripts/dev.mjs",
    "dev:desktop": "node scripts/launch.mjs --qa --profile=development --port=4384",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts tests/*.test.mjs",
    "build": "npm run build:service && node scripts/prepare-desktop.mjs && vite build && node scripts/budget.mjs",
    "version:bump": "node scripts/version.mjs",
    "validate:release": "node scripts/validate.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate && npm --prefix deploy/vercel audit --omit=dev --audit-level=moderate",
    "quality": "npm run typecheck && npm test && npm run security:audit && npm run validate:release && npm run build",
    "shortcut": "node scripts/shortcut.mjs",
    "launch": "node scripts/launch.mjs",
    "postinstall": "node scripts/prepare-pty.mjs",
    "build:service": "tsc -p tsconfig.service.json && node scripts/prepare-worker-plugin.mjs && node scripts/prepare-key-vault.mjs",
    "qa:launch": "node scripts/launch.mjs --qa",
    "qa:launch:win": "node scripts/launch.mjs --qa",
    "start:host": "node scripts/host.mjs",
    "server:key:init": "node scripts/server-key.mjs",
    "package:companion": "node scripts/package-companion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.3.0",
    "@icon-park/react": "1.4.2",
    "@napi-rs/canvas": "1.0.9",
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "clsx": "2.1.1",
    "croner": "10.0.1",
    "decode-named-character-reference": "1.3.0",
    "htmlparser2": "10.1.0",
    "i18next": "26.4.2",
    "mailparser": "3.9.23",
    "node-pty": "1.1.0",
    "nodemailer": "10.0.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-markdown": "9.1.0",
    "react-syntax-highlighter": "16.1.1",
    "react-virtuoso": "4.18.3",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "three": "0.186.0",
    "zod": "4.4.3",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.24",
    "electron": "44.2.0",
    "jsqr": "1.4.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
