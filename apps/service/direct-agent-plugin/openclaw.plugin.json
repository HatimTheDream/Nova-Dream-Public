{
  "id": "edition3-direct-agent",
  "name": "Nova Dream direct-agent reads",
  "description": "Read-only original-run authority for the controlled direct-agent route.",
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["nova_direct_read"],
    "trustedToolPolicies": ["nova-direct-read-only"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "epoch": { "type": "string", "format": "uuid" },
      "bundlePath": { "type": "string", "minLength": 1 },
      "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "url": { "type": "string", "format": "uri" },
      "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "required": ["epoch", "bundlePath", "policySha256", "url", "token"]
  }
}
